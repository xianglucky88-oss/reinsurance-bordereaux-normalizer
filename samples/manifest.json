    {
      "id": "F20-retroactive-restatement-narrowing",
      "file": "F20-retroactive-restatement-narrowing.json",
      "title": "A limit narrowing rewrites an already-reported movement",
      "demonstrates": "Changing a layer re-prices movements that were reported under the old version.",
      "notes": "Same M1 under the v1 layer 100 xs 100 (sample F01 territory) allocates 50; under this v2 layer 100 xs 20 it allocates 20. The movement did not change, only the treaty.",
