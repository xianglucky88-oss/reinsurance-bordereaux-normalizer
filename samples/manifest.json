    {
      "id": "F18-silent-row-drop",
      "file": "F18-silent-row-drop.json",
      "title": "Non-object rows are silently discarded",
      "demonstrates": "parser.py:5 keeps only dict rows; malformed rows vanish with no error and no counter.",
      "notes": "Only M1 survives. Nothing records that 3 input rows were dropped, so row counts cannot be reconciled.",
      "expected_result": {
        "project": "reinsurance-bordereaux-normalizer",
        "status": "ok",
        "cumulative_loss": 120.0,
        "allocations": [
          {
            "claim": "C1",
            "movement": "M1",
            "treaty": "L1",
            "allocated": 120.0
          }
        ],
        "unallocated": 0.0
      }
    },
    {
      "id": "F19-resubmitted-file-concatenation",
      "file": "F19-resubmitted-file-concatenation.json",
      "title": "The same file submitted twice, concatenated",
      "demonstrates": "There is no file identity, so a resubmission is just more rows and silently doubles the run.",
      "notes": "Compare with F01 (same file once): cumulative 200 -> 400, L2 total 50 -> 100, unallocated 100 -> 250. Nothing flags the second copy.",
      "expected_result": {
        "project": "reinsurance-bordereaux-normalizer",
        "status": "ok",
        "cumulative_loss": 400.0,
        "allocations": [
